<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_xs"
    android:paddingEnd="@dimen/spacing_xs">

    <!-- Gradient Ring around Story -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp">

        <View
            android:id="@+id/vStoryRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_story_ring" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivStoryAvatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_profile" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvStoryUsername"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="user"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/text_xs" />

</LinearLayout>
